# ─────────────────────────────────────────────────────────────
# city546 configuration. Copy to `.env` and adjust:
#   cp .env.example .env
# Never commit your real `.env`.
# ─────────────────────────────────────────────────────────────

# Environment: development | production | test
NODE_ENV=development

# Port the Express API listens on
PORT=5000

# How many reverse proxies sit in front of the app (for correct client IPs in rate limiting).
# 1 = one proxy (Railway, Nginx). 2 = Vercel rewrite → Railway.
TRUST_PROXY=1

# PostgreSQL connection string
# (matches docker-compose.yml if you use `npm run db:up`)
DATABASE_URL=postgresql://city546:city546_dev_password@localhost:5432/city546

# Set to true for hosted databases that require TLS (Neon, Supabase, RDS, ...)
DATABASE_SSL=false

# Secret used to sign auth tokens — use a long random string (>= 32 chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
# Token lifetime (e.g. 30m, 12h, 7d)
JWT_EXPIRES_IN=12h

# Comma-separated list of origins allowed to call the API from a browser.
# Not needed in development (Vite proxies /api), needed if the frontend is hosted elsewhere.
CORS_ORIGIN=http://localhost:5173

# ── The single Admin account (used by `npm run db:seed`) ──
ADMIN_EMAIL=admin@city546.local
ADMIN_NAME=city546 Admin
# Development: a plaintext password here is hashed with bcrypt by the seed script.
# The database only ever stores the bcrypt hash.
ADMIN_PASSWORD=change_this_password
# Production: leave ADMIN_PASSWORD empty and set a pre-computed hash instead:
#   npm run hash-password -- "your-strong-password"
ADMIN_PASSWORD_HASH=

# ── Image uploads ──
# Folder where photos uploaded by the admin are stored (relative to the project root).
# In production, put this on persistent storage (a mounted volume) and back it up.
UPLOAD_DIR=backend/uploads
# Maximum size of one uploaded image, in MB (large phone photos are resized in the browser first)
MAX_UPLOAD_MB=8

# Seed sample news posts (only when the posts table is empty)
SEED_SAMPLE_POSTS=true

# ── AI writing style (optional) ──
# The AI runs ONLY on the server; keys are never sent to the browser.
#   anthropic = Claude via the official Anthropic SDK (needs AI_API_KEY or ANTHROPIC_API_KEY)
#   mock      = offline demo mode (no real AI, no cost) — handy for trying the workflow
#   none      = AI features off (posts are created manually as before)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=claude-opus-5
# Optional reasoning effort: low | medium | high | xhigh | max (blank = provider default)
AI_EFFORT=
# Reserved for providers that offer embeddings (semantic retrieval); unused with Claude
AI_EMBEDDING_MODEL=
# Max reference posts sent per style analysis, and examples retrieved per generated post
AI_ANALYSIS_MAX_POSTS=150
AI_EXAMPLES_PER_GENERATION=3
AI_TIMEOUT_MS=180000
# Allow RSS/Atom feeds on private network addresses (leave false in production)
ALLOW_PRIVATE_FEED_URLS=false

# ── Meta connectors (optional) — sync Facebook Pages / Instagram accounts via the official Graph API ──
# Server-side only. Use a long-lived Page access token or a System User token from your Meta app.
#   Facebook Pages you manage: pages_read_engagement (+ pages_read_user_content)
#   Other public Pages:        Meta's "Page Public Content Access" feature (App Review)
#   Instagram (Business Discovery): instagram_basic + pages_read_engagement, and your own
#                                   Instagram Business/Creator account id in META_IG_USER_ID
META_ACCESS_TOKEN=
# Optional but recommended: your Meta app secret — requests are signed with appsecret_proof
META_APP_SECRET=
META_IG_USER_ID=
META_GRAPH_VERSION=v26.0
META_MAX_POSTS_PER_SYNC=100

# ── TikTok connector (optional) — official Login Kit + Display API ──
# Reads the public videos of TikTok accounts that authorise city546 (e.g. your own channel).
# Register this exact redirect URI in the TikTok developer portal (HTTPS, public domain):
#   https://YOUR-DOMAIN/api/oauth/tiktok/callback
# Scopes requested: user.info.basic, video.list
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_MAX_POSTS_PER_SYNC=100
# Only if the admin UI is served from a different origin than the API (e.g. https://news.example.com)
FRONTEND_URL=
# Optional: key used to encrypt stored third-party tokens (defaults to a key derived from JWT_SECRET).
# Changing it means connected accounts must reconnect.
TOKEN_ENCRYPTION_KEY=
